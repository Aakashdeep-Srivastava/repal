# ─── PayPal (sandbox) ───────────────────────────────────────────────
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=SANDBOX
PAYPAL_WEBHOOK_ID=
PAYPAL_OIDC_REDIRECT=http://localhost:3000/api/auth/paypal/callback

# ─── Channel3 (product + offer discovery, Agent A3) ─────────────────
# Server-side key (free at trychannel3.com). Discovery is LIVE when this is set.
CHANNEL3_API_KEY=
CHANNEL3_COUNTRY=US                  # ISO 3166-1 alpha-2 (US, GB, DE, …)
CHANNEL3_CURRENCY=USD                # ISO 4217 (USD, GBP, EUR, …)
# Discovery mode — INDEPENDENT of the PayPal payment mode (DEMO_MODE):
#   auto (default) = live when CHANNEL3_API_KEY is set, else demo catalog
#   live           = always Channel3 (errors without a key)
#   demo           = always the labelled sandbox catalog
CHANNEL3_MODE=auto

# ─── Model: Claude via AWS Bedrock (reclevo.in account) ─────────────
# Auth — set ONE of these (Bearer key preferred). See docs/BEDROCK.md.
AWS_BEARER_TOKEN_BEDROCK=            # a Bedrock API key (recommended, simplest)
# AWS_ACCESS_KEY_ID=                 # — or — least-privilege IAM user
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=                 # only if using temporary STS creds
AWS_REGION=us-west-2                 # co-located with the Oregon Neon DB
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0   # available + cheap; Opus 4.8/Sonnet 5 need extra access

# ─── Model (direct Anthropic — personal dev fallback, PERSONAL/.env.local) ──
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# ─── Database ───────────────────────────────────────────────────────
DATABASE_URL=postgresql://repal:repal@localhost:5432/repal?schema=public

# ─── Receipts (Ed25519, base64-encoded private key) ─────────────────
RECEIPT_SIGNING_KEY=

# ─── Cross-border display ───────────────────────────────────────────
FX_INR_PER_USD=84

# ─── Session ────────────────────────────────────────────────────────
# Secret used to HMAC-sign the `repal_session` cookie (lib/auth/session.ts).
# MUST be set in production to a random 32+ byte value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# If unset, a documented dev-only fallback is used (local dev / demo only).
SESSION_SECRET=

# ─── Flags ──────────────────────────────────────────────────────────
DEMO_MODE=true
