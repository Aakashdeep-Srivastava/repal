# ════════════════════════════════════════════════════════════════════════
#  RePal — consolidated environment reference
#
#  Copy to .env.local and fill in. Every variable the app reads is listed here,
#  grouped by concern. Secrets are blank; non-secret defaults are pre-filled.
#  Team split: shared, non-personal values live in .env; personal keys/secrets
#  live in .env.local (git-ignored). Next.js loads both (.env.local wins).
# ════════════════════════════════════════════════════════════════════════

# ─── Database (Postgres / Neon) ─────────────────────────────────────────
# DATABASE_URL = pooled (PgBouncer) connection — app runtime.
# DIRECT_URL   = direct connection — prisma migrate / introspection.
# For local Docker Postgres both can be the same URL; for Neon use the pooled
# and direct strings from the dashboard.
DATABASE_URL=postgresql://repal:repal@localhost:5432/repal?schema=public
DIRECT_URL=postgresql://repal:repal@localhost:5432/repal?schema=public

# ─── Model: Claude via AWS Bedrock (Agent layer) ────────────────────────
# Auth — set ONE path (Bearer key preferred). See docs/BEDROCK.md.
AWS_BEARER_TOKEN_BEDROCK=             # Bedrock API key (recommended, simplest)
# AWS_ACCESS_KEY_ID=                  # — or — least-privilege IAM user
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=                  # only with temporary STS creds
AWS_REGION=us-west-2                  # co-located with the Oregon Neon DB
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0  # available + cheap
#
# ── AI provider FALLBACK CHAIN ──────────────────────────────────────────
# The agent handle is a fallback chain: providers are tried in priority order
# and a transient failure (throttle/quota/auth/payment/5xx) fails over to the
# next. Set whichever keys you have; any configured provider joins the chain.
# Order (default: bedrock,groq,anthropic,openai,gemini); override if you like:
# AI_PROVIDER_ORDER=bedrock,groq,gemini,anthropic,openai
# Legacy single-select (optional): if set, becomes PRIMARY, rest follow.
# AI_PROVIDER=bedrock
#
# Free, no credit card, tool-calling (great while Bedrock warms up):
# GROQ_API_KEY=                        # console.groq.com  (fast; Llama 3.3 70B)
# GROQ_MODEL=llama-3.3-70b-versatile
# GEMINI_API_KEY=                      # aistudio.google.com
# GEMINI_MODEL=gemini-2.0-flash
# Direct providers (paid):
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OpenRouter — OpenAI-compatible gateway with free models (openrouter.ai):
# OPENROUTER_API_KEY=                  # openrouter.ai/keys
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free  # vendor/model[:free]

# ─── Product discovery: Channel3 (Agent A3) ─────────────────────────────
# Server-side key (free at trychannel3.com). Discovery is LIVE when set.
CHANNEL3_API_KEY=
CHANNEL3_COUNTRY=US                   # ISO 3166-1 alpha-2 (US, GB, DE, …)
CHANNEL3_CURRENCY=USD                 # ISO 4217 (USD, GBP, EUR, …)
# Discovery mode — INDEPENDENT of the PayPal payment mode (DEMO_MODE):
#   auto (default) = live when CHANNEL3_API_KEY is set, else demo catalog
#   live           = always Channel3 (errors without a key)
#   demo           = always the labelled sandbox catalog
CHANNEL3_MODE=auto

# ─── Merchant logos: Brandfetch (cold-start rewards feed) ───────────────
# OPTIONAL. The rewards cards already show real logos with NO key, via free
# no-signup fallbacks (logos.hunter.io / logoapi.sh). Set this to upgrade to
# Brandfetch's official, higher-consistency logos (~1M req/mo free, NO
# attribution). Public (browser) var — must be present at BUILD time to take
# effect (bake it into the Docker image / CI build for prod, not just runtime).
# Free client id: https://developers.brandfetch.com/register
NEXT_PUBLIC_BRANDFETCH_CLIENT_ID=

# ─── Payments: PayPal (sandbox) ─────────────────────────────────────────
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=SANDBOX
PAYPAL_WEBHOOK_ID=
# In production set to https://<your-host>/api/auth/paypal/callback
PAYPAL_OIDC_REDIRECT=http://localhost:3000/api/auth/paypal/callback

# ─── Security: receipts + session ───────────────────────────────────────
# RECEIPT_SIGNING_KEY — Ed25519 private key, base64 (PKCS#8 DER). Generate:
#   node -e "const{generateKeyPairSync}=require('crypto');console.log(generateKeyPairSync('ed25519').privateKey.export({format:'der',type:'pkcs8'}).toString('base64'))"
RECEIPT_SIGNING_KEY=
# SESSION_SECRET — HMAC for the repal_session cookie. 32+ random bytes:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# If unset, a documented dev-only fallback is used (local/demo only).
SESSION_SECRET=

# ─── Localization + flags ───────────────────────────────────────────────
FX_INR_PER_USD=84                     # cross-border display only
DEMO_MODE=true                        # sandbox payment flow (separate from CHANNEL3_MODE)

# ─── Legal pages (/privacy, /terms) ─────────────────────────────────────
# Optional public contact shown on the privacy & terms pages.
NEXT_PUBLIC_CONTACT_EMAIL=

# ── Gmail ingestion (optional; consent-first, read-only) ──
# Leave unset to keep Gmail OFF (wallet falls back to labelled sample data).
# Create an OAuth 2.0 Web client in Google Cloud Console; add the callback
# https://<your-host>/api/connect/gmail/callback as an authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional override; defaults to <PAYPAL_OIDC_REDIRECT origin>/api/connect/gmail/callback
GOOGLE_REDIRECT_URI=
# How broadly the agent reads mail: rewards (default, server-side reward filter)
# | promotions (Gmail Promotions tab) | full (reads across the inbox). Storage is
# ALWAYS reward-only regardless of mode. Broader modes read more personal mail —
# the /connect/gmail consent screen discloses this.
GMAIL_SCAN_MODE=rewards
