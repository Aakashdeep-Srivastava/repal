# ╔══════════════════════════════════════════════════════════════════╗
# ║  RePal environment — template. Copy the values, never commit real  ║
# ║  secrets. See docs/ENV.md for the team workflow.                   ║
# ╚══════════════════════════════════════════════════════════════════╝
#
# TWO files (both git-ignored):
#   .env        → SHARED team config. Get the filled file from the team
#                 channel. Read by BOTH Prisma (CLI) and Next.js.
#   .env.local  → PERSONAL overrides (your own model key). You create this.
#                 Next.js reads it ON TOP OF .env (wins on conflict).
#
# This .env.example documents every variable. Fill a real .env from it.

# ─── SHARED → .env ──────────────────────────────────────────────────

# Database (Neon "RePal"). Pooled for the app, direct for `prisma migrate`.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require

# PayPal sandbox (developer.paypal.com → Apps & Credentials → Sandbox).
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=SANDBOX
PAYPAL_WEBHOOK_ID=                 # set after the webhook URL exists (post-deploy)
PAYPAL_OIDC_REDIRECT=http://localhost:3000/api/auth/paypal/callback

# Channel3 (trychannel3.com/dashboard → API key; x-api-key auth).
CHANNEL3_API_KEY=

# Receipt signing — Ed25519 private key, base64 (pkcs8 DER). We generate it
# ourselves; it must be the SAME across the team + deploy or receipts won't
# verify. Generate with:
#   node -e "const{generateKeyPairSync}=require('crypto');const{privateKey}=generateKeyPairSync('ed25519');console.log(privateKey.export({type:'pkcs8',format:'der'}).toString('base64'))"
RECEIPT_SIGNING_KEY=

# Cross-border display + flags.
FX_INR_PER_USD=84
DEMO_MODE=true

# ─── PERSONAL → .env.local ──────────────────────────────────────────

# Your own model key (each dev uses their own; not shared, for cost).
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
